---
import { execSync } from 'node:child_process';
import Base from '../layouts/Base.astro';
import Employer from '../components/Employer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LineChart, { type Series } from '../components/LineChart.astro';
import covidCsv from '../data/ucla-covid-cumulative-cases.csv?raw';
import LikelihoodBarChart, { type LikelihoodRow } from '../components/LikelihoodBarChart.astro';
import felonyMurderData from '../data/felony-murder-race-by-state.json';
import ProjectionChart from '../components/ProjectionChart.astro';
import Methodology from '../components/Methodology.astro';
import Math from '../components/Math.astro';
import { gradeProjection, todayDate } from '../data/simulated-grade-projection';

// Cumulative confirmed COVID-19 cases among incarcerated people, from the
// UCLA Law COVID Behind Bars Data Project's per-state time series files.
// Colors are categorical slots 1–3 of the validated chart palette, with the
// palette's own dark-mode steps.
const covidSeries: Series[] = [
  { name: 'All State Prisons, AR', label: 'Arkansas prisons', color: '#2a78d6', colorDark: '#3987e5', points: [] },
  { name: 'Los Angeles Jails, CA', label: 'LA jails', color: '#eb6834', colorDark: '#d95926', points: [] },
  { name: 'Bellamy Creek Correctional Facility, MI', label: 'Bellamy Creek', color: '#1baf7a', colorDark: '#199e70', points: [] },
];
// Felony murder: how many times more likely Black people are than white people
// to be incarcerated for felony murder, as published on each state page of the
// Felony Murder Reporting Project. Per-state caveats (data rating, measure,
// exclusions) are kept in the JSON and left to the project's own state pages.
const felonyMurderRows: LikelihoodRow[] = felonyMurderData.map((d) => ({ name: d.state, ratio: d.ratio }));

for (const line of covidCsv.trim().split(/\r?\n/).slice(1)) {
  const m = line.match(/^"?(.*?)"?,(\d{4}-\d{2}-\d{2}),(\d+)$/);
  if (!m) throw new Error(`Unreadable row in ucla-covid-cumulative-cases.csv: ${line}`);
  const target = covidSeries.find((s) => s.name === m[1]);
  if (!target) throw new Error(`Unknown series in ucla-covid-cumulative-cases.csv: ${m[1]}`);
  target.points.push({ date: m[2], value: Number(m[3]) });
}

const tabs = ['about', 'projects', 'contact'];

// "Last updated": the month of the latest commit. GitHub rebuilds the site on
// every push, so this tracks real content changes. Falls back to build time.
let updated = new Date();
try {
  updated = new Date(execSync('git log -1 --format=%cI', { encoding: 'utf8' }).trim());
} catch {}
const updatedLabel = updated.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const updatedIso = updated.toISOString().slice(0, 7);
---

<Base>
  <main class="min-h-screen flex items-start justify-center px-6 pt-24 md:pt-40 pb-24">
    <div class="w-full max-w-2xl text-base text-ink leading-relaxed">
      <!-- Header row: the site icon on the left, spanning the height of the two
           right-hand rows (theme toggle and last-updated date). -->
      <div class="mb-6 flex justify-between items-stretch">
        <div class="self-stretch">
          <!-- Placeholder icon: Phosphor "smiley", regular weight (MIT license, phosphoricons.com). -->
          <svg class="h-full w-auto text-ink" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
            <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216ZM80,108a12,12,0,1,1,12,12A12,12,0,0,1,80,108Zm96,0a12,12,0,1,1-12-12A12,12,0,0,1,176,108Zm-1.07,48c-10.29,17.79-27.4,28-46.93,28s-36.63-10.2-46.92-28a8,8,0,1,1,13.84-8c7.47,12.91,19.21,20,33.08,20s25.61-7.1,33.07-20a8,8,0,0,1,13.86,8Z"/>
          </svg>
        </div>
        <div class="flex flex-col items-end gap-2">
          <ThemeToggle />
          <p class="text-sm text-ink/55">Last updated <time datetime={updatedIso}>{updatedLabel}</time></p>
        </div>
      </div>
      <p>
        I’m Baji! I use emerging technologies to critically examine the world we live in. Currently, I am a member of technical staff at
        <Employer name="Vals AI" href="https://www.vals.ai/home" />, building evals for social mobility (SNAP, Medicare, etc.) and mental health.
      </p>

      <!-- Tabs, then a CV link styled like them. The CV is a plain link (it opens
           a PDF), so it sits outside the tablist rather than posing as a tab. -->
      <div class="mt-10 flex flex-wrap items-start gap-x-6 sm:gap-x-8 gap-y-2 text-sm">
      <div role="tablist" aria-label="Sections" class="flex flex-wrap gap-x-6 sm:gap-x-8 gap-y-2">
        {tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab}`}
            data-tab={tab}
            aria-controls={`panel-${tab}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="pb-0.5 border-b-[1.5px] border-transparent text-ink/55 hover:text-ink transition-colors aria-selected:text-ink aria-selected:border-ink cursor-pointer"
          >
            {tab}
          </button>
        ))}
      </div>
      <a
        href="https://drive.google.com/file/d/1Z_qzO2KrPefsfszXgmbxgJzbBeBNGS9O/view?usp=sharing"
        target="_blank"
        rel="noopener noreferrer"
        class="pb-0.5 border-b-[1.5px] border-transparent text-ink/55 hover:text-ink transition-colors"
      >cv</a>
      </div>

      <!-- Only the selected panel is shown; the others are hidden entirely, so
           the page is only as tall as the tab you're on. -->
      <div class="mt-8">
        <div id="panel-about" role="tabpanel" aria-labelledby="tab-about" class="space-y-6">
          <p>
            Previously, I led analytics engineering at <Employer name="Subject" href="https://subject.com" />, building the predictive layer of content delivery for students.
          </p>
          <p>
            I was the lead data scientist on a <Employer name="New Yorker" href="https://www.newyorker.com/magazine/2023/12/18/felony-murder-laws" /> article on felony
            murder convictions that won the 2024 <Employer name="Pulitzer Prize" href="https://www.pulitzer.org/winners/sarah-stillman-new-yorker" /> for
            Explanatory Reporting.
          </p>
          <p>
            Before that, I was a research programmer at <Employer name="USC" href="https://hpri.usc.edu/" />'s
            Homelessness Policy Research Institute, a researcher at
            <Employer name="RAND" href="https://www.rand.org/" />, and a data scientist for the <Employer name="UCLA" href="https://uclaprisondata.org/" /> Behind Bars Data Project.
          </p>
        </div>

        <div id="panel-projects" role="tabpanel" aria-labelledby="tab-projects" class="hidden space-y-16">
          <div class="space-y-4">
          <ProjectionChart
            title="Simulated: projecting a student's final grade at Subject"
            subtitle="Course grade so far in a 10-unit physics course, 2025–26 (average of the work graded to date). Actual work through the January midterm; projected range for the rest of the year."
            points={gradeProjection}
            todayDate={todayDate}
            colors={{ actual: '#2a78d6', optimistic: '#008300', pessimistic: '#e34948' }}
            colorsDark={{ actual: '#3987e5', optimistic: '#008300', pessimistic: '#e66767' }}
          />
          <Methodology>
            <p>
              Subject's predictive model estimates each student's final course grade as a range
              rather than a single number. It uses quantile gradient-boosted trees, which predict a
              pessimistic, a realistic and an optimistic outcome, and calibrates those ranges with
              conformalized quantile regression so they hold up in practice. The calibration is
              asymmetric and done separately within groups, so the downside can be wider than the
              upside. The model is retrained and rescored nightly, using only information that would
              have been available at the time of each prediction.
            </p>
            <p>
              The chart uses simulated data: one fictional student in a 10-unit physics course, with
              actual grades through the January midterm and projections like the model's for the
              rest of the year.
            </p>
          </Methodology>
          </div>
          <div class="space-y-4">
          <LikelihoodBarChart
            title="Felony murder: how much more likely Black people are to be incarcerated than white people"
            subtitle="Each bar splits the two groups' likelihood of incarceration for felony murder: white residents are 1 part, Black residents the number shown."
            notes={[
              {
                before: 'For state-specific information, visit the ',
                linkText: 'Felony Murder Reporting Project’s state pages',
                href: 'https://felonymurderreporting.org/states/',
                after: '.',
              },
            ]}
            source="Felony Murder Reporting Project"
            sourceHref="https://felonymurderreporting.org/states/"
            baseLabel="White"
            compareLabel="Black"
            baseColor="#0D0F10"
            compareColor="#FF6752"
            baseColorDark="#F2F0EF"
            rows={felonyMurderRows}
          />
          <Methodology>
            <p>
              The Felony Murder Reporting Project assembled state data from public records requests,
              online prison rosters and existing research. A few states, such as Connecticut, Maine
              and Wisconsin, record felony murder under its own statute in their correctional data.
              In others it had to be identified through legal definitions and charge codes, or by
              matching court records to correctional rosters. Of the 18 states where analysis was
              possible, 11 had datasets verified as close to complete and 7 had partial data; most
              states could not provide usable data at all.
            </p>
            <p>
              Each ratio comes from Bayes' theorem. For each group, the likelihood of being
              incarcerated for felony murder (FM) is
            </p>
            <Math display tex={String.raw`P(\text{FM} \mid \text{Black}) = \frac{P(\text{Black} \mid \text{FM}) \, P(\text{FM})}{P(\text{Black})}`} />
            <p>
              where <Math tex={String.raw`P(\text{Black} \mid \text{FM})`} /> is the group's share of
              felony murder cases, <Math tex={String.raw`P(\text{FM})`} /> is the state's overall
              felony murder rate, and <Math tex={String.raw`P(\text{Black})`} /> is the group's share
              of the state's population (2022 Census estimates). The number shown is the ratio
            </p>
            <Math display tex={String.raw`\frac{P(\text{FM} \mid \text{Black})}{P(\text{FM} \mid \text{White})}`} />
            <p>
              These are overall rates. They don't adjust for other factors such as age, income or
              criminal history, so they measure the size of the disparity rather than the effect of
              race alone. In Colorado the comparison is of convictions, and in Alabama of charges,
              rather than incarceration.
            </p>
          </Methodology>
          </div>
          <LineChart
            title="COVID-19 cases among incarcerated people, 2020–2023"
            subtitle="Cumulative confirmed cases among people held in each system or facility."
            note="Data reflect what carceral agencies reported. Each line ends at its last available report."
            source="UCLA Law COVID Behind Bars Data Project"
            sourceHref="https://uclaprisondata.org/"
            valueLabel="Cumulative cases"
            series={covidSeries}
          />
        </div>

        <div id="panel-contact" role="tabpanel" aria-labelledby="tab-contact" class="hidden">
          <ul class="space-y-2">
            <li>
              <a href="https://www.linkedin.com/in/baji-tumendemberel-93a0b4121/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-ink/30 hover:decoration-ink">LinkedIn</a>
            </li>
            <li>
              <a href="https://github.com/bajitumen" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-ink/30 hover:decoration-ink">GitHub</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </main>

  <!-- Tabs. Inline (not bundled) so it runs as soon as the markup above is
       parsed, before any other script: tabs and #links work immediately, even
       while the chart library is still downloading. -->
  <script is:inline>
    (() => {
      const tabs = Array.from(document.querySelectorAll('[role="tab"]'));

      function select(tab, updateHash = true) {
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls'))?.classList.toggle('hidden', !on);
        }
        if (updateHash) history.replaceState(null, '', `#${tab.dataset.tab}`);
      }

      for (const tab of tabs) {
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (e) => {
          const i = tabs.indexOf(tab);
          const next =
            e.key === 'ArrowRight' ? tabs[(i + 1) % tabs.length] :
            e.key === 'ArrowLeft' ? tabs[(i - 1 + tabs.length) % tabs.length] :
            e.key === 'Home' ? tabs[0] :
            e.key === 'End' ? tabs[tabs.length - 1] :
            null;
          if (!next) return;
          e.preventDefault();
          select(next);
          next.focus();
        });
      }

      // Open the tab named in the URL, e.g. bajitumen.com/#contact
      const fromHash = () => tabs.find((t) => t.dataset.tab === location.hash.slice(1));
      if (fromHash()) select(fromHash(), false);
      // Also follow later changes, e.g. the back button or an in-page #link.
      window.addEventListener('hashchange', () => {
        if (fromHash()) select(fromHash(), false);
      });
    })();
  </script>
</Base>
