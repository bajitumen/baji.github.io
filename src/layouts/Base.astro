---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Baji Tumendemberel',
  description = 'Personal site of Baji Tumendemberel — data science and social justice.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Set the theme before the page paints, so it never flashes the wrong
         colors: the visitor's saved choice, else their device setting. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const saved = () => {
          try {
            const t = localStorage.getItem('theme');
            return t === 'light' || t === 'dark' ? t : null;
          } catch {
            return null;
          }
        };
        root.dataset.theme = saved() ?? (media.matches ? 'dark' : 'light');
        // Until the visitor picks a theme with the toggle, follow their device
        // setting live (e.g. when it switches to dark mode at sunset).
        media.addEventListener('change', () => {
          if (saved()) return;
          root.classList.add('theme-switching');
          root.dataset.theme = media.matches ? 'dark' : 'light';
          requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('theme-switching')));
          document.dispatchEvent(new CustomEvent('themechange'));
        });
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
