---
// Header row shared by every page: the site icon on the left, spanning the
// height of the two right-hand rows (theme toggle and last-updated date).
// The icon goes to the about tab. On the home page the tab script handles it
// in place (data-tab-link); elsewhere it's an ordinary link home.
import { execSync } from 'node:child_process';
import ThemeToggle from './ThemeToggle.astro';
import Smiley from './Smiley.astro';

interface Props {
  home?: boolean; // true on the home page
}

const { home = false } = Astro.props;

// "Last updated": the month of the latest commit. GitHub rebuilds the site on
// every push, so this tracks real content changes. Falls back to build time.
let updated = new Date();
try {
  updated = new Date(execSync('git log -1 --format=%cI', { encoding: 'utf8' }).trim());
} catch {}
const updatedLabel = updated.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const updatedIso = updated.toISOString().slice(0, 7);
---

<div class="mb-6 flex justify-between items-stretch">
  <a
    href={home ? '#about' : '/#about'}
    data-tab-link={home ? 'about' : undefined}
    aria-label="Go to about"
    class="self-stretch text-ink hover:opacity-70 transition-opacity"
  >
    <!-- Awake in light mode, asleep in dark mode. -->
    <Smiley />
  </a>
  <div class="flex flex-col items-end gap-2">
    <ThemeToggle />
    <p class="text-sm text-ink/55">Last updated <time datetime={updatedIso}>{updatedLabel}</time></p>
  </div>
</div>
