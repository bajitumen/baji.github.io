---
// A back arrow at the start of a project chart's title, linking to the
// projects tab. If the visitor got here by navigating within the site, it goes
// back in history like the browser's Back button, returning to the same tab
// and scroll position. The page router numbers its history entries
// (history.state.index), so anything above 0 came from within the site.
// Otherwise (e.g. a shared link) it opens the projects tab.
// Icon: Phosphor "arrow-left", regular weight (MIT license, phosphoricons.com).
---

<a
  id="back-to-projects"
  href="/#projects"
  aria-label="Back to projects"
  class="mr-2 inline-flex align-[-0.15em] text-ink/55 hover:text-ink transition-colors"
>
  <svg class="h-[1.1em] w-[1.1em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
    <path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"/>
  </svg>
</a>
<!-- data-astro-rerun: run again each time a project page is swapped in. -->
<script is:inline data-astro-rerun>
  document.getElementById('back-to-projects').addEventListener('click', (e) => {
    if ((history.state?.index ?? 0) > 0) {
      e.preventDefault();
      history.back();
    }
  });
</script>
